{
  "name": "NIGHTRUN — Neon District",
  "short_name": "NIGHTRUN",
  "description": "A neon-lit 3D endless runner. Run the district, dodge the grid, collect shards. Fully playable offline.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
